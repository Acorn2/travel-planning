{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lodging area recommendation",
  "type": "object",
  "required": ["id", "kind", "name", "area", "why_here", "check_in", "check_out", "nights", "location", "route_note", "source_ids"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"const": "area"},
    "name": {"type": "string", "minLength": 1},
    "area": {"type": "string", "minLength": 1},
    "why_here": {"type": "string", "minLength": 1},
    "check_in": {"type": "string", "format": "date"},
    "check_out": {"type": "string", "format": "date"},
    "nights": {"type": "integer", "minimum": 1},
    "location": {
      "type": "object", "required": ["address", "precision"],
      "properties": {"address": {"type": "string", "minLength": 1}, "precision": {"const": "area"}}
    },
    "route_note": {"type": "string", "minLength": 1},
    "selection_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "budget": {
      "type": "object", "required": ["status", "currency", "nightly_range", "rooms", "basis"],
      "properties": {
        "status": {"const": "estimated"},
        "currency": {"type": "string", "minLength": 1},
        "nightly_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
        "rooms": {"type": "integer", "minimum": 1},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "action_links": {"type": "array", "items": {"type": "object"}},
    "inventory_refs": false, "quote": false, "price": false, "hotel_name": false,
    "occupancy": false, "requested_occupancy": false, "bed_type": false
  }
}
