{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "mode", "research_depth", "depth_reason", "decision_factors", "name", "meal_type", "applicable_date", "time_window", "checked_at", "area_dining"],
  "properties": {
    "id": {"type": "string", "minLength": 1}, "mode": {"const": "area"},
    "research_depth": {"const": "basic"}, "depth_reason": {"type": "string", "minLength": 1},
    "decision_factors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "routine"}},
    "name": {"type": "string", "minLength": 1}, "meal_type": {"enum": ["breakfast", "lunch", "dinner"]},
    "applicable_date": {"type": "string", "format": "date"},
    "time_window": {"type": "string", "minLength": 1}, "checked_at": {"type": "string", "format": "date-time"},
    "area_dining": {
      "type": "object",
      "required": ["name", "physical_address", "food_options", "budget_per_person", "why_here", "availability_basis", "route_note", "fallback", "source_ids", "action_links"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "physical_address": {"type": "string", "minLength": 1},
        "food_options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "budget_per_person": {"type": "number", "exclusiveMinimum": 0},
        "why_here": {"type": "string", "minLength": 1}, "availability_basis": {"type": "string", "minLength": 1},
        "route_note": {"type": "string", "minLength": 1},
        "fallback": {
          "type": "object", "required": ["name", "physical_address", "plan"],
          "additionalProperties": false,
          "properties": {"name": {"type": "string", "minLength": 1, "pattern": "\\S"}, "physical_address": {"type": "string", "minLength": 1, "pattern": "\\S"}, "plan": {"type": "string", "minLength": 1, "pattern": "\\S"}}
        },
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "action_links": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "candidate_ids": false, "selected_candidate_id": false, "candidates": false, "baseline_route_id": false
  }
}
