{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planning.local/schemas/travel-source-error.schema.json",
  "title": "Travel Source Query Error",
  "type": "object",
  "required": ["schema_version", "status", "failure_kind", "message", "checked_at"],
  "properties": {
    "schema_version": {"const": "travel-source-error/v1"},
    "status": {"const": "error"},
    "failure_kind": {
      "enum": [
        "credential_missing",
        "authorization_failed",
        "login_required",
        "verification_required",
        "filter_unavailable",
        "quota_exceeded",
        "runtime_unavailable",
        "timeout",
        "invalid_response",
        "workspace_error",
        "provider_error",
        "unsupported_provider"
      ]
    },
    "message": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "search_attempts": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["attempt", "checked_at", "filters", "status", "elapsed_ms"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
          "checked_at": {"type": "string", "format": "date-time"},
          "filters": {"type": "object", "additionalProperties": {"type": "string"}},
          "status": {"enum": ["success", "no_results", "failed"]},
          "elapsed_ms": {"type": "integer", "minimum": 0},
          "failure_kind": {"type": "string"},
          "login_recheck": {"type": "string"},
          "recovery": {"enum": ["retry_same_query", "retry_without_filters"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
